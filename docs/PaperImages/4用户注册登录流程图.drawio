<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram id="login-flow-simple-v2" name="用户注册登录流程图">
    <mxGraphModel dx="1678" dy="999" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;labelBackgroundColor=none;" value="开始" vertex="1">
          <mxGeometry height="40" width="120" x="340" y="30" as="geometry" />
        </mxCell>
        <mxCell id="q1" parent="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="是否已有账号？" vertex="1">
          <mxGeometry height="80" width="200" x="300" y="110" as="geometry" />
        </mxCell>
        <mxCell id="reg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="填写注册信息" vertex="1">
          <mxGeometry height="40" width="140" x="80" y="250" as="geometry" />
        </mxCell>
        <mxCell id="create" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="校验并创建账号" vertex="1">
          <mxGeometry height="40" width="140" x="80" y="340" as="geometry" />
        </mxCell>
        <mxCell id="login" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="输入用户名和密码" vertex="1">
          <mxGeometry height="40" width="160" x="320" y="250" as="geometry" />
        </mxCell>
        <mxCell id="submit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="提交登录请求" vertex="1">
          <mxGeometry height="40" width="160" x="320" y="340" as="geometry" />
        </mxCell>
        <mxCell id="q2" parent="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="登录是否成功？" vertex="1">
          <mxGeometry height="80" width="190" x="305" y="430" as="geometry" />
        </mxCell>
        <mxCell id="login_fail" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="提示登录失败" vertex="1">
          <mxGeometry height="40" width="130" x="570" y="450" as="geometry" />
        </mxCell>
        <mxCell id="check" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="校验身份与角色" vertex="1">
          <mxGeometry height="40" width="160" x="320" y="560" as="geometry" />
        </mxCell>
        <mxCell id="enter" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="进入对应角色界面&#xa;并加载功能菜单" vertex="1">
          <mxGeometry height="60" width="220" x="290" y="650" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;labelBackgroundColor=none;" value="结束" vertex="1">
          <mxGeometry height="40" width="120" x="340" y="770" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;" target="q1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="q1" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;" target="reg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2l" connectable="0" parent="e2" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="否" vertex="1">
          <mxGeometry relative="1" x="-0.25" y="-10" as="geometry">
            <mxPoint x="-8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="q1" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;" target="login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3l" connectable="0" parent="e3" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="是" vertex="1">
          <mxGeometry relative="1" x="0.25" y="-10" as="geometry">
            <mxPoint x="8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="reg" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;" target="create">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="create" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;" target="login">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="275" y="360" />
              <mxPoint x="275" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="login" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;" target="submit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="submit" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;" target="q2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="q2" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8l" connectable="0" parent="e8" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="是" vertex="1">
          <mxGeometry relative="1" x="-0.2" y="-10" as="geometry">
            <mxPoint x="-8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="q2" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;" target="login_fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9l" connectable="0" parent="e9" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="否" vertex="1">
          <mxGeometry relative="1" x="0.2" y="-10" as="geometry">
            <mxPoint x="8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="login_fail" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;" target="login">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="642" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="check" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;" target="enter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="enter" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
