<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram id="llm-flow-simple" name="LLM复核与告警处置流程图">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="1200" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;labelBackgroundColor=none;" value="开始" vertex="1">
          <mxGeometry x="360" y="30" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="n1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="接收YOLO中置信度结果" vertex="1">
          <mxGeometry x="320" y="100" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="n2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="提取告警截图与上下文信息" vertex="1">
          <mxGeometry x="320" y="180" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="调用多模态LLM进行复核" vertex="1">
          <mxGeometry x="320" y="260" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="n4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="返回复核结论与处置建议" vertex="1">
          <mxGeometry x="320" y="340" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="d1" parent="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="复核结论是否为真实火灾？" vertex="1">
          <mxGeometry x="295" y="420" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="l1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="生成正式告警并推送前端" vertex="1">
          <mxGeometry x="70" y="440" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="l2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="操作员按SOP处置并提交结果" vertex="1">
          <mxGeometry x="70" y="520" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="r1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="记录误报原因" vertex="1">
          <mxGeometry x="610" y="440" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="r2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="标记告警为误报归档" vertex="1">
          <mxGeometry x="610" y="520" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="保存复核结果与处理记录" vertex="1">
          <mxGeometry x="320" y="650" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="n6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="写入历史告警库" vertex="1">
          <mxGeometry x="320" y="730" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="end" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;labelBackgroundColor=none;" value="结束" vertex="1">
          <mxGeometry x="360" y="820" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="start" target="n1" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n1" target="n2" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="n2" target="n3" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="n3" target="n4" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="n4" target="d1" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" edge="1" parent="1" source="d1" target="l1" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6l" connectable="0" parent="e6" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="是" vertex="1">
          <mxGeometry relative="1" x="-0.35" y="-10" as="geometry">
            <mxPoint x="-8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e7" edge="1" parent="1" source="d1" target="r1" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7l" connectable="0" parent="e7" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="否" vertex="1">
          <mxGeometry relative="1" x="0.25" y="-10" as="geometry">
            <mxPoint x="8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e8" edge="1" parent="1" source="l1" target="l2" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" edge="1" parent="1" source="r1" target="r2" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e10" edge="1" parent="1" source="l2" target="n5" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="250" y="670" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e11" edge="1" parent="1" source="r2" target="n5" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="690" y="670" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e12" edge="1" parent="1" source="n5" target="n6" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e13" edge="1" parent="1" source="n6" target="end" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
