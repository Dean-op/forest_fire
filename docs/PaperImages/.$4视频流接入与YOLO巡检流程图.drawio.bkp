<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram id="yolo-flow-simple" name="视频流接入与YOLO巡检流程图">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1120" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;labelBackgroundColor=none;" value="开始" vertex="1">
          <mxGeometry x="350" y="30" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="stream" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="接入摄像头视频流" vertex="1">
          <mxGeometry x="320" y="100" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="online" parent="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="设备是否在线？" vertex="1">
          <mxGeometry x="295" y="180" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="offline" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="记录设备异常状态" vertex="1">
          <mxGeometry x="585" y="200" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="capture" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="按设定间隔抓取视频帧" vertex="1">
          <mxGeometry x="320" y="310" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="yolo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="送入YOLO模型检测" vertex="1">
          <mxGeometry x="320" y="390" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="fire" parent="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="是否检测到疑似火情？" vertex="1">
          <mxGeometry x="280" y="470" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="next" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="继续下一轮巡检" vertex="1">
          <mxGeometry x="590" y="490" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="conf" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="输出检测结果与置信度" vertex="1">
          <mxGeometry x="320" y="590" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="high" parent="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="置信度是否高于告警阈值？" vertex="1">
          <mxGeometry x="280" y="670" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="alert" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="生成告警并推送前端" vertex="1">
          <mxGeometry x="60" y="690" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="low" parent="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="置信度是否低于忽略阈值？" vertex="1">
          <mxGeometry x="280" y="790" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="archive" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="记为低风险结果" vertex="1">
          <mxGeometry x="600" y="810" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="llm" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="转入LLM复核流程" vertex="1">
          <mxGeometry x="330" y="920" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="end" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;labelBackgroundColor=none;" value="结束" vertex="1">
          <mxGeometry x="775" y="200" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="start" target="stream" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" edge="1" parent="1" source="stream" target="online" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" edge="1" parent="1" source="online" target="capture" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3l" connectable="0" parent="e3" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="是" vertex="1">
          <mxGeometry relative="1" x="-0.2" y="-10" as="geometry">
            <mxPoint x="-8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e4" edge="1" parent="1" source="online" target="offline" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4l" connectable="0" parent="e4" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="否" vertex="1">
          <mxGeometry relative="1" x="0.2" y="-10" as="geometry">
            <mxPoint x="8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e5" edge="1" parent="1" source="offline" target="end" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" edge="1" parent="1" source="capture" target="yolo" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" edge="1" parent="1" source="yolo" target="fire" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" edge="1" parent="1" source="fire" target="conf" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8l" connectable="0" parent="e8" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="是" vertex="1">
          <mxGeometry relative="1" x="-0.2" y="-10" as="geometry">
            <mxPoint x="-8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e9" edge="1" parent="1" source="fire" target="next" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9l" connectable="0" parent="e9" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="否" vertex="1">
          <mxGeometry relative="1" x="0.2" y="-10" as="geometry">
            <mxPoint x="8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e10" edge="1" parent="1" source="next" target="capture" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="510" />
              <mxPoint x="760" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e11" edge="1" parent="1" source="conf" target="high" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e12" edge="1" parent="1" source="high" target="alert" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12l" connectable="0" parent="e12" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="是" vertex="1">
          <mxGeometry relative="1" x="-0.35" y="-10" as="geometry">
            <mxPoint x="-8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e13" edge="1" parent="1" source="high" target="low" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
