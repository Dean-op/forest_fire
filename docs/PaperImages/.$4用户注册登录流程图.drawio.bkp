<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.6 Chrome/144.0.7559.236 Electron/40.8.4 Safari/537.36" version="29.6.6">
  <diagram id="login-flow-simple" name="用户注册登录流程图">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;labelBackgroundColor=none;" value="开始" vertex="1">
          <mxGeometry x="340" y="30" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="q1" parent="1" style="rhombus;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="是否已有账号？" vertex="1">
          <mxGeometry x="300" y="110" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="reg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="填写注册信息" vertex="1">
          <mxGeometry x="80" y="250" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="create" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="校验并创建账号" vertex="1">
          <mxGeometry x="80" y="340" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="login" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="输入用户名和密码" vertex="1">
          <mxGeometry x="320" y="250" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="submit" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="提交登录请求" vertex="1">
          <mxGeometry x="320" y="340" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="check" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="校验身份与角色" vertex="1">
          <mxGeometry x="320" y="430" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="enter" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=13;labelBackgroundColor=none;" value="进入对应角色界面&#xa;并加载功能菜单" vertex="1">
          <mxGeometry x="290" y="520" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="end" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=14;labelBackgroundColor=none;" value="结束" vertex="1">
          <mxGeometry x="340" y="640" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="start" target="q1" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" edge="1" parent="1" source="q1" target="reg" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2l" parent="e2" connectable="0" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="否" vertex="1">
          <mxGeometry relative="1" x="-0.25" y="-10" as="geometry">
            <mxPoint x="-8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e3" edge="1" parent="1" source="q1" target="login" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3l" parent="e3" connectable="0" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="是" vertex="1">
          <mxGeometry relative="1" x="0.25" y="-10" as="geometry">
            <mxPoint x="8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e4" edge="1" parent="1" source="reg" target="create" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" edge="1" parent="1" source="create" target="login" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5l" parent="e5" connectable="0" style="edgeLabel;html=1;fontSize=12;labelBackgroundColor=none;" value="注册完成" vertex="1">
          <mxGeometry relative="1" x="-0.1" y="-10" as="geometry">
            <mxPoint x="0" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e6" edge="1" parent="1" source="login" target="submit" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" edge="1" parent="1" source="submit" target="check" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" edge="1" parent="1" source="check" target="enter" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" edge="1" parent="1" source="enter" target="end" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;labelBackgroundColor=none;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
